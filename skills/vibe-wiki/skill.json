{
  "name": "vibe-wiki",
  "version": "1.0.0",
  "description": "Build and maintain a persistent, compounding wiki from URLs and local files.",
  "tags": ["wiki", "knowledge-management", "rag", "notes", "second-brain"],
  "install": {
    "skill": "SKILL.md",
    "assets": {
      "schemas": "assets/schemas/",
      "starter": "assets/starter/",
      "config_template": "assets/vibe-wiki.template.yaml"
    }
  },
  "commands": ["wiki init", "wiki ingest", "wiki query", "wiki lint", "wiki help", "wiki generate schema"]
}
